# All secrets stay on the server. Never commit .env.
PORT=3000
HOST=127.0.0.1
PUBLIC_ORIGIN=http://localhost:3000
# In production: PUBLIC_ORIGIN=https://velnovaragroup.eu
CONTACT_TO=velnovaragroup@gmail.com
# Create a Resend API key, and use a sender on your verified domain.
RESEND_API_KEY=
CONTACT_FROM="Velnovara Group <website@velnovaragroup.eu>"
# Set to 1 only behind a trusted proxy that overwrites X-Forwarded-For.
TRUST_PROXY=0
# Public address of the live site, used for canonical links, sharing previews and the sitemap.
SITE_URL=https://velnovaragroup.eu
